# --- Veritabani ---
DB_NAME=hotel_db
DB_USERNAME=hotel_user
DB_PASSWORD=change_me_db_password
DB_PORT=5432

# --- Portlar (host tarafi) ---
FRONTEND_PORT=3000
BACKEND_PORT=9090

# --- JWT (en az 32 karakter) ---
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# --- CORS (nginx proxy kullanildigi icin normalde gerekmez; dogrudan 9090'a istek atarsaniz kullanilir) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Ilk acilista olusan admin hesabi (giristen sonra sifreyi degistirin) ---
DEFAULT_ADMIN_EMAIL=admin@hotel.com
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_NAME=Sistem Yoneticisi

# --- iyzico (https://sandbox-merchant.iyzipay.com panelinden kendi sandbox anahtarlarinizi alin) ---
IYZICO_API_KEY=sandbox-api-key
IYZICO_SECRET_KEY=sandbox-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com